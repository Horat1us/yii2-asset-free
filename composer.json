{
  "name": "horat1us/yii2-asset-free",
  "description": "Disable bower-asset for Yii2",
  "type": "library",
  "require": {
    "php": ">=8.4",
    "yiisoft/yii2": "^2.0.53"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "horat1us",
      "email": "reclamme@gmail.com"
    }
  ],
  "minimum-stability": "stable",
  "replace": {
    "bower-asset/jquery": "*",
    "bower-asset/jquery.inputmask": "*",
    "bower-asset/inputmask": "*",
    "bower-asset/punycode": "*",
    "bower-asset/yii2-pjax": "*"
  },
  "scripts": {
    "test": "./test.sh"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.4.1"
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    }
  }
}
